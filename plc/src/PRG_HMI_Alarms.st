PROGRAM PRG_HMI_Alarms
// Generated by codesys-mcp-toolkit for the HMI screen 'Alarms' (42 variables). Rebuilt on every export.
VAR
    iMachine : INT; // the machine's state: 0 idle, 1.. the states in order
    sV1 : STRING(80); // GVL_HmiView.sState
    sV2 : STRING(80); // GVL_HmiView.sMode
    rV3 : REAL; // GVL_HmiView.sNewestAlarm
END_VAR

IF GVL_HmiView.xAborted THEN iMachine := 1; ELSIF GVL_HmiView.xHeld THEN iMachine := 2; ELSIF GVL_HmiView.xActing THEN iMachine := 3; ELSIF GVL_HmiView.xManual THEN iMachine := 4; ELSIF GVL_HmiView.xExecute THEN iMachine := 5; ELSIF GVL_HmiView.xIdle THEN iMachine := 6; ELSE iMachine := 0; END_IF
sV1 := TO_STRING(GVL_HmiView.sState);
sV2 := TO_STRING(GVL_HmiView.sMode);
rV3 := ANY_TO_REAL(GVL_HmiView.sNewestAlarm);
