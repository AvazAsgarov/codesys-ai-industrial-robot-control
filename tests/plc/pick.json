{
  "cases": [
    {
      "name": "single_part_placed_in_target_bin",
      "steps": [
        {
          "write": {
            "GVL_Config.xCellEnabled": false
          }
        },
        {
          "waitMs": 300
        },
        {
          "write": {
            "PRG_TestPick.xActive": true,
            "PRG_TestPick.xBeltRun": true
          }
        },
        {
          "waitMs": 2500
        },
        {
          "write": {
            "PRG_TestPick.fbSeq.xRun": true
          }
        },
        {
          "waitMs": 12000
        },
        {
          "expect": {
            "PRG_TestPick.fbSeq.eStep": "E_PickStep.WaitPart"
          }
        },
        {
          "write": {
            "PRG_TestPick.usiInjClass": 1,
            "PRG_TestPick.eInjQuality": 1,
            "PRG_TestPick.lrInjX": 1000,
            "PRG_TestPick.xInject": true
          }
        },
        {
          "waitMs": 24000
        },
        {
          "expect": {
            "PRG_TestPick.fbSeq.udiPlaced": 1,
            "PRG_TestPick.fbSeq.eLastBin": "E_Bin.TypeB",
            "PRG_TestPick.fbAlarms.xErrorActive": false,
            "PRG_TestPick.fbAlarms.xCriticalActive": false
          }
        },
        {
          "waitMs": 6000
        },
        {
          "expect": {
            "PRG_TestPick.fbSeq.eStep": "E_PickStep.WaitPart"
          }
        }
      ]
    },
    {
      "name": "run_false_finishes_then_idles",
      "steps": [
        {
          "write": {
            "PRG_TestPick.fbSeq.xRun": false
          }
        },
        {
          "waitMs": 12000
        },
        {
          "expect": {
            "PRG_TestPick.fbSeq.eStep": "E_PickStep.Idle",
            "PRG_TestPick.fbSeq.xIdleAtHome": true
          }
        }
      ]
    },
    {
      "name": "vacuum_lost_in_transfer_stops_cell",
      "steps": [
        {
          "write": {
            "PRG_TestPick.xDropOnTransfer": true,
            "PRG_TestPick.fbSeq.xRun": true
          }
        },
        {
          "waitMs": 8000
        },
        {
          "write": {
            "PRG_TestPick.usiInjClass": 0,
            "PRG_TestPick.eInjQuality": 1,
            "PRG_TestPick.lrInjX": 1000,
            "PRG_TestPick.xInject": true
          }
        },
        {
          "waitMs": 16000
        },
        {
          "expect": {
            "PRG_TestPick.fbSeq.eStep": "E_PickStep.Error",
            "PRG_TestPick.fbTracker.udiDropped": 1,
            "PRG_TestPick.fbAlarms.xErrorActive": true,
            "PRG_TestPick.fbVac.xValveOn": true,
            "PRG_TestPick.fbRobot.xMoving": false
          }
        }
      ]
    },
    {
      "name": "part_passing_window_end_is_abandoned",
      "steps": [
        {
          "write": {
            "PRG_TestPick.fbSeq.xRun": false,
            "PRG_TestPick.xResetSeq": true
          }
        },
        {
          "waitMs": 1000
        },
        {
          "expect": {
            "PRG_TestPick.fbSeq.eStep": "E_PickStep.Idle",
            "PRG_TestPick.fbVac.xValveOn": false
          }
        },
        {
          "write": {
            "PRG_TestPick.xDropOnTransfer": false,
            "PRG_TestPick.fbSeq.xRun": true
          }
        },
        {
          "waitMs": 8000
        },
        {
          "write": {
            "PRG_TestPick.fbRobot.lrOverride": 0.05,
            "PRG_TestPick.usiInjClass": 0,
            "PRG_TestPick.eInjQuality": 1,
            "PRG_TestPick.lrInjX": 1440,
            "PRG_TestPick.xInject": true
          }
        },
        {
          "waitMs": 12000
        },
        {
          "write": {
            "PRG_TestPick.fbRobot.lrOverride": 1.0
          }
        },
        {
          "waitMs": 6000
        },
        {
          "expect": {
            "PRG_TestPick.fbTracker.udiMissed": 1,
            "PRG_TestPick.fbSeq.udiPlaced": 1,
            "PRG_TestPick.fbSeq.eStep": "E_PickStep.WaitPart",
            "PRG_TestPick.fbVac.xValveOn": false
          }
        },
        {
          "write": {
            "PRG_TestPick.fbSeq.xRun": false
          }
        },
        {
          "waitMs": 8000
        },
        {
          "expect": {
            "PRG_TestPick.fbSeq.eStep": "E_PickStep.Idle"
          }
        }
      ]
    },
    {
      "name": "abort_keeps_vacuum",
      "steps": [
        {
          "write": {
            "PRG_TestPick.fbSeq.xRun": false
          }
        },
        {
          "waitMs": 1000
        },
        {
          "expect": {
            "PRG_TestPick.fbSeq.eStep": "E_PickStep.Idle"
          }
        },
        {
          "write": {
            "PRG_TestPick.xAbortOnLift": true,
            "PRG_TestPick.fbSeq.xRun": true
          }
        },
        {
          "waitMs": 8000
        },
        {
          "write": {
            "PRG_TestPick.usiInjClass": 2,
            "PRG_TestPick.eInjQuality": 1,
            "PRG_TestPick.lrInjX": 1000,
            "PRG_TestPick.xInject": true
          }
        },
        {
          "waitMs": 12000
        },
        {
          "expect": {
            "PRG_TestPick.fbSeq.eStep": "E_PickStep.Aborted",
            "PRG_TestPick.fbVac.xValveOn": true,
            "PRG_TestPick.fbRobot.xMoving": false
          }
        },
        {
          "write": {
            "PRG_TestPick.xAbortOnLift": false,
            "PRG_TestPick.xResetSeq": true
          }
        },
        {
          "waitMs": 1000
        },
        {
          "write": {
            "PRG_TestPick.fbSeq.xRun": true
          }
        },
        {
          "waitMs": 14000
        },
        {
          "expect": {
            "PRG_TestPick.fbSeq.udiPlaced": 2,
            "PRG_TestPick.fbSeq.eLastBin": "E_Bin.Quarantine",
            "PRG_TestPick.fbVac.xValveOn": false,
            "PRG_TestPick.xSawRecoverLift": true
          }
        },
        {
          "write": {
            "PRG_TestPick.xAbortOnLift": false,
            "PRG_TestPick.fbSeq.xRun": false,
            "PRG_TestPick.xResetSeq": true
          }
        },
        {
          "waitMs": 500
        }
      ]
    },
    {
      "name": "pick_height_follows_class",
      "steps": [
        {
          "write": {
            "PRG_TestPick.fbSeq.xRun": true
          }
        },
        {
          "waitMs": 12000
        },
        {
          "write": {
            "PRG_TestPick.usiInjClass": 1,
            "PRG_TestPick.eInjQuality": 1,
            "PRG_TestPick.lrInjX": 1000,
            "PRG_TestPick.xInject": true
          }
        },
        {
          "waitMs": 24000
        },
        {
          "expect": {
            "PRG_TestPick.lrGripZ": {
              "op": "=",
              "value": 76.19,
              "tolerance": 1.0
            },
            "PRG_TestPick.fbAlarms.xErrorActive": false
          }
        },
        {
          "write": {
            "PRG_TestPick.usiInjClass": 0,
            "PRG_TestPick.eInjQuality": 1,
            "PRG_TestPick.lrInjX": 1000,
            "PRG_TestPick.xInject": true
          }
        },
        {
          "waitMs": 24000
        },
        {
          "expect": {
            "PRG_TestPick.lrGripZ": {
              "op": "=",
              "value": 51.39,
              "tolerance": 1.0
            }
          }
        }
      ]
    },
    {
      "name": "unidentified_part_not_picked",
      "steps": [
        {
          "write": {
            "PRG_TestPick.xInjInvalid": true,
            "PRG_TestPick.usiInjClass": 0,
            "PRG_TestPick.eInjQuality": 1,
            "PRG_TestPick.lrInjX": 1000,
            "PRG_TestPick.xInject": true
          }
        },
        {
          "waitMs": 14000
        },
        {
          "expect": {
            "PRG_TestPick.fbSeq.eStep": "E_PickStep.WaitPart",
            "PRG_TestPick.fbAlarms.xErrorActive": false,
            "PRG_TestPick.fbAlarms.xCriticalActive": false,
            "PRG_TestPick.fbSeq.udiPlaced": 4,
            "PRG_TestPick.fbTracker.udiMissed": 2
          }
        },
        {
          "write": {
            "PRG_TestPick.xInjInvalid": false,
            "PRG_TestPick.fbSeq.xRun": false
          }
        },
        {
          "waitMs": 8000
        },
        {
          "write": {
            "PRG_TestPick.xActive": false
          }
        },
        {
          "waitMs": 200
        },
        {
          "expect": {
            "PRG_TestPick.xActive": false
          }
        }
      ]
    }
  ]
}
