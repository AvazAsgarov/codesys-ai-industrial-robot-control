{
  "cases": [
    {
      "name": "apply_highspeed",
      "steps": [
        { "write": { "PRG_Recipe_Cell.iApply": 1 } },
        { "waitMs": 500 },
        {
          "expect": {
            "GVL_Params.lrBeltSpeed": { "op": "=", "value": 200, "tolerance": 0.001 },
            "GVL_Params.lrLinVelocity": { "op": "=", "value": 800, "tolerance": 0.001 },
            "GVL_Params.lrPtpVelFactor": { "op": "=", "value": 0.8, "tolerance": 0.0001 }
          }
        }
      ]
    },
    {
      "name": "apply_standard_restores",
      "steps": [
        { "write": { "PRG_Recipe_Cell.iApply": 0 } },
        { "waitMs": 500 },
        {
          "expect": {
            "GVL_Params.lrBeltSpeed": { "op": "=", "value": 100, "tolerance": 0.001 },
            "GVL_Params.lrLinVelocity": { "op": "=", "value": 500, "tolerance": 0.001 },
            "GVL_Params.lrPtpVelFactor": { "op": "=", "value": 0.5, "tolerance": 0.0001 }
          }
        }
      ]
    }
  ]
}
