{
  "cases": [
    {
      "name": "full_cycle_three_parts",
      "steps": [
        {
          "write": {
            "PRG_TestCell.xActive": true,
            "GVL_Config.xCellEnabled": true
          }
        },
        {
          "waitMs": 500
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Stopped"
          }
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 1
          }
        },
        {
          "waitMs": 3000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Idle"
          }
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 2
          }
        },
        {
          "waitMs": 12000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Execute"
          }
        },
        {
          "write": {
            "PRG_TestCell.usiInjClass": 0,
            "PRG_TestCell.eInjQuality": 1,
            "PRG_TestCell.xInject": true
          }
        },
        {
          "waitMs": 300
        },
        {
          "waitMs": 9000
        },
        {
          "write": {
            "PRG_TestCell.usiInjClass": 1,
            "PRG_TestCell.eInjQuality": 1,
            "PRG_TestCell.xInject": true
          }
        },
        {
          "waitMs": 300
        },
        {
          "waitMs": 9000
        },
        {
          "write": {
            "PRG_TestCell.usiInjClass": 0,
            "PRG_TestCell.eInjQuality": 3,
            "PRG_TestCell.xInject": true
          }
        },
        {
          "waitMs": 300
        },
        {
          "waitMs": 22000
        },
        {
          "expect": {
            "PRG_Main.fbCell.aBins[0].uiCount": 1,
            "PRG_Main.fbCell.aBins[1].uiCount": 1,
            "PRG_Main.fbCell.aBins[4].uiCount": 1,
            "PRG_Main.fbCell.fbAlarms.xErrorActive": false,
            "PRG_Main.fbCell.fbAlarms.xCriticalActive": false
          }
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Execute"
          }
        }
      ]
    },
    {
      "name": "stop_completes_at_home",
      "steps": [
        {
          "write": {
            "GVL_Hmi.eCommand": 3
          }
        },
        {
          "waitMs": 9000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Stopped"
          }
        },
        {
          "expect": {
            "PRG_Main.fbCell.fbSeq.xIdleAtHome": true
          }
        }
      ]
    },
    {
      "name": "estop_during_transfer_keeps_vacuum",
      "steps": [
        {
          "write": {
            "GVL_Hmi.eCommand": 1
          }
        },
        {
          "waitMs": 3000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Idle"
          }
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 2
          }
        },
        {
          "waitMs": 12000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Execute"
          }
        },
        {
          "write": {
            "PRG_TestCell.xEStopOnTransfer": true
          }
        },
        {
          "write": {
            "PRG_TestCell.usiInjClass": 1,
            "PRG_TestCell.eInjQuality": 1,
            "PRG_TestCell.xInject": true
          }
        },
        {
          "waitMs": 300
        },
        {
          "waitMs": 16000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Aborted"
          }
        },
        {
          "expect": {
            "GVL_Bridge.xVacuumOn": true,
            "PRG_Main.fbCell.fbRobot.xMoving": false
          }
        },
        {
          "write": {
            "PRG_TestCell.xEStopOnTransfer": false,
            "GVL_Bridge.xEStopOk": true
          }
        },
        {
          "waitMs": 300
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 9
          }
        },
        {
          "waitMs": 4000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Stopped"
          }
        }
      ]
    },
    {
      "name": "door_open_in_production_aborts",
      "steps": [
        {
          "write": {
            "GVL_Hmi.eCommand": 1
          }
        },
        {
          "waitMs": 3000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Idle"
          }
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 2
          }
        },
        {
          "waitMs": 12000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Execute"
          }
        },
        {
          "write": {
            "GVL_Bridge.xDoorClosed": false
          }
        },
        {
          "waitMs": 2000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Aborted"
          }
        },
        {
          "write": {
            "GVL_Bridge.xDoorClosed": true
          }
        },
        {
          "waitMs": 300
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 9
          }
        },
        {
          "waitMs": 4000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Stopped"
          }
        }
      ]
    },
    {
      "name": "bin_full_suspends",
      "steps": [
        {
          "write": {
            "GVL_Hmi.eCommand": 1
          }
        },
        {
          "waitMs": 3000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Idle"
          }
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 2
          }
        },
        {
          "waitMs": 12000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Execute"
          }
        },
        {
          "write": {
            "GVL_Bridge.axBinFull[0]": true
          }
        },
        {
          "waitMs": 9000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Suspended"
          }
        },
        {
          "write": {
            "GVL_Bridge.axBinFull[0]": false
          }
        },
        {
          "waitMs": 12000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Execute"
          }
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 3
          }
        },
        {
          "waitMs": 9000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Stopped"
          }
        }
      ]
    },
    {
      "name": "manual_jog_only_in_manual",
      "steps": [
        {
          "write": {
            "GVL_Hmi.eCommand": 1
          }
        },
        {
          "waitMs": 3000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Idle"
          }
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 2
          }
        },
        {
          "waitMs": 12000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Execute"
          }
        },
        {
          "write": {
            "PRG_TestCell.xMark": true
          }
        },
        {
          "waitMs": 300
        },
        {
          "write": {
            "GVL_Hmi.axJogPlus[1]": true
          }
        },
        {
          "waitMs": 1500
        },
        {
          "write": {
            "GVL_Hmi.axJogPlus[1]": false
          }
        },
        {
          "expect": {
            "PRG_TestCell.lrJ1Delta": {
              "op": "=",
              "value": 0,
              "tolerance": 0.01
            }
          }
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 3
          }
        },
        {
          "waitMs": 9000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Stopped"
          }
        },
        {
          "write": {
            "GVL_Hmi.eModeRequest": 3
          }
        },
        {
          "waitMs": 500
        },
        {
          "expect": {
            "GVL_Bridge.eMode": "E_PackMLMode.Manual"
          }
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 1
          }
        },
        {
          "waitMs": 3000
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 2
          }
        },
        {
          "waitMs": 3000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Execute"
          }
        },
        {
          "write": {
            "PRG_TestCell.xMark": true
          }
        },
        {
          "waitMs": 300
        },
        {
          "write": {
            "GVL_Hmi.axJogPlus[1]": true
          }
        },
        {
          "waitMs": 1500
        },
        {
          "write": {
            "GVL_Hmi.axJogPlus[1]": false
          }
        },
        {
          "waitMs": 500
        },
        {
          "expect": {
            "PRG_TestCell.lrJ1Delta": {
              "op": ">",
              "value": 5
            }
          }
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 3
          }
        },
        {
          "waitMs": 3000
        },
        {
          "write": {
            "GVL_Hmi.eModeRequest": 1,
            "PRG_TestCell.xActive": false
          }
        },
        {
          "waitMs": 500
        },
        {
          "expect": {
            "GVL_Bridge.eMode": "E_PackMLMode.Production"
          }
        }
      ]
    }
  ]
}
