{
  "cases": [
    {
      "name": "full_cycle_three_parts",
      "steps": [
        {
          "write": {
            "PRG_TestCell.xActive": true,
            "GVL_Config.xCellEnabled": true
          }
        },
        {
          "waitMs": 500
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Stopped"
          }
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 1
          }
        },
        {
          "waitMs": 3000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Idle"
          }
        },
        {
          "write": {
            "GVL_Hmi.eCommand": 2
          }
        },
        {
          "waitMs": 16000
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Execute"
          }
        },
        {
          "write": {
            "PRG_TestCell.usiInjClass": 0,
            "PRG_TestCell.eInjQuality": 1,
            "PRG_TestCell.xInject": true
          }
        },
        {
          "waitMs": 300
        },
        {
          "waitMs": 9000
        },
        {
          "write": {
            "PRG_TestCell.usiInjClass": 1,
            "PRG_TestCell.eInjQuality": 1,
            "PRG_TestCell.xInject": true
          }
        },
        {
          "waitMs": 300
        },
        {
          "waitMs": 9000
        },
        {
          "write": {
            "PRG_TestCell.usiInjClass": 0,
            "PRG_TestCell.eInjQuality": 3,
            "PRG_TestCell.xInject": true
          }
        },
        {
          "waitMs": 300
        },
        {
          "waitMs": 22000
        },
        {
          "expect": {
            "PRG_Main.fbCell.aBins[0].uiCount": 1,
            "PRG_Main.fbCell.aBins[1].uiCount": 1,
            "PRG_Main.fbCell.aBins[4].uiCount": 1,
            "PRG_Main.fbCell.fbAlarms.xErrorActive": false,
            "PRG_Main.fbCell.fbAlarms.xCriticalActive": false
          }
        },
        {
          "expect": {
            "GVL_Bridge.eState": "E_PackMLState.Execute",
            "GVL_Bridge.udiSetpointSeq": {
              "op": ">",
              "value": 1000
            }
          }
        }
      ]
    },
    {
